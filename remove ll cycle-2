class Solution {
public:
    ListNode *detectCycle(ListNode *head) {
        if(head == nullptr || head->next == nullptr) return nullptr;

        ListNode* fast=head;
        ListNode* slow=head;
        
        while(fast != nullptr && fast->next !=nullptr)
        {
            fast  = fast->next->next;
            slow =  slow->next;

            if(fast == slow)
            break;
        }
        if(fast ==  nullptr || fast->next ==  nullptr)  return nullptr;
         
         ListNode*temp = head;
         
         while(temp != slow)
         {
            temp=temp->next;
            slow=slow->next;

         }
         return slow;
    }
};
