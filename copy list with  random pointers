class Solution {
public:
    Node* copyRandomList(Node* head) {

        if (head == NULL)
            return NULL;

        Node* curr = head;

        while (curr != NULL) {

            Node* copy = new Node(curr->val);

            copy->next = curr->next;
            curr->next = copy;

            curr = copy->next;
        }

        curr = head;

        while (curr != NULL) {

            if (curr->random != NULL) {
                curr->next->random = curr->random->next;
            }

            curr = curr->next->next;
        }

        Node* dummy = new Node(0);
        Node* copyTail = dummy;

        curr = head;

        while (curr != NULL) {

            Node* copy = curr->next;

            curr->next = copy->next;

            copyTail->next = copy;
            copyTail = copy;

            curr = curr->next;
        }

        return dummy->next;
    }
};
